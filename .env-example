# Server Configuration
NODE_ENV=development
PORT=9000
CORS_ORIGIN=*
BODY_LIMIT=1mb
TZ=Asia/Bangkok
API_BASE_PATH=/api

# Auth Configuration
ENABLE_REGISTRATION=true

# Multiple Login Configuration
MULTIPLE_LOGIN_ENABLED=false
MAX_SESSIONS=1
# เวลาที่ให้ session หมดอายุหลังจากไม่มีการใช้งาน (วินาที)
SESSION_IDLE_TIMEOUT=1800
# เวลาที่ให้ session หมดอายุหลังจาก login (วินาที)
SESSION_ABSOLUTE_TIMEOUT=43200

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=1d
# เปิด/ปิดการใช้ refresh token
REFRESH_TOKEN_ENABLED=true
REFRESH_TOKEN_EXPIRES_IN=7d
# เปิด/ปิดการใช้ blacklist token
TOKEN_BLACKLIST_ENABLED=true
# เวลาที่เก็บ blacklist token (วินาที)
TOKEN_BLACKLIST_TTL=86400

# Token Storage Configuration
TOKEN_STORAGE_TYPE=redis  # 'redis' or 'database'

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_RETRY_ATTEMPTS=10
REDIS_RETRY_DELAY=2000
# เปิด/ปิดการใช้ Redis Cluster
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002
# เปิด/ปิดการใช้ Redis Sentinel
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_NODES=localhost:26379,localhost:26380,localhost:26381
REDIS_SENTINEL_MASTER=mymaster

# Queue Configuration
QUEUE_NAME=insertQueue
JOB_TTL=86400
JOB_RETENTION=86400
MAX_JOBS=1000
QUEUE_CONCURRENCY=5
QUEUE_LIMITER_MAX=100
QUEUE_LIMITER_DURATION=1000

# Cache Configuration
CACHE_TTL=60
# เปิด/ปิดการใช้ cache
CACHE_ENABLED=true
# ประเภทของ cache (redis, memory)
CACHE_TYPE=redis
# เปิด/ปิดการใช้ compression สำหรับ cache
CACHE_COMPRESSION_ENABLED=true
# ขนาดข้อมูลขั้นต่ำที่จะทำ compression (bytes)
CACHE_COMPRESSION_THRESHOLD=1024

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# เปิด/ปิดการใช้ sliding window
RATE_LIMIT_SLIDING_WINDOW=true
# เปิด/ปิดการแยก rate limit ตาม path
RATE_LIMIT_SEPARATE_PATHS=true

# Security Configuration
# เปิด/ปิดการใช้ CSRF protection
CSRF_ENABLED=true
CSRF_SECRET=your-csrf-secret
# เปิด/ปิดการใช้ XSS protection
XSS_ENABLED=true
# เปิด/ปิดการใช้ SQL injection protection
SQL_INJECTION_PROTECTION_ENABLED=true
# เปิด/ปิดการใช้ request validation
REQUEST_VALIDATION_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
# เปิด/ปิดการแยกไฟล์รายวัน
LOG_ROTATE_ENABLED=true
# เก็บไฟล์นานกี่วัน
LOG_MAX_FILES=14d
# ขนาดไฟล์สูงสุดก่อนแยกไฟล์ใหม่
LOG_MAX_SIZE=20m
# รูปแบบวันที่ในชื่อไฟล์
LOG_DATE_PATTERN=YYYY-MM-DD
# เปิด/ปิดการลบไฟล์อัตโนมัติ
LOG_CLEANUP_ENABLED=true
# ลบไฟล์ที่เก่ากว่ากี่วัน
LOG_MAX_AGE=14
# เวลาที่จะลบ (Cron format)
LOG_CLEANUP_SCHEDULE=0 0 * * *

# Log Types Configuration
# Application logs
LOG_APP_ENABLED=true
LOG_APP_FILENAME=application.log
# Error logs
LOG_ERROR_ENABLED=true
LOG_ERROR_FILENAME=error.log
# HTTP logs
LOG_HTTP_ENABLED=true
LOG_HTTP_FILENAME=http.log
# API logs
LOG_API_ENABLED=true
LOG_API_FILENAME=api.log
# Exception logs
LOG_EXCEPTION_ENABLED=true
LOG_EXCEPTION_FILENAME=exception.log
# Rejection logs
LOG_REJECTION_ENABLED=true
LOG_REJECTION_FILENAME=rejection.log

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vital_db
DB_USER=root
DB_PASS=your_password
DB_DIALECT=mysql
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# เปิด/ปิดการใช้ SSL
DB_SSL_ENABLED=false
DB_SSL_CA_PATH=/path/to/ca.pem
# เปิด/ปิดการใช้ connection timeout
DB_TIMEOUT_ENABLED=true
DB_TIMEOUT=5000
# เปิด/ปิดการใช้ query timeout
DB_QUERY_TIMEOUT_ENABLED=true
DB_QUERY_TIMEOUT=30000

# Monitoring Configuration
# เปิด/ปิดการใช้ health check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
# เปิด/ปิดการใช้ metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics
# เปิด/ปิดการใช้ tracing
TRACING_ENABLED=true
# ประเภทของ tracing (jaeger, zipkin)
TRACING_TYPE=jaeger
TRACING_ENDPOINT=http://localhost:14268/api/traces

# Documentation Configuration
# เปิด/ปิดการใช้ Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
# เปิด/ปิดการใช้ API versioning
API_VERSIONING_ENABLED=true
API_VERSION=v1
